NODE_ENV=development
PORT=5000
# trace | debug | info | warn | error | fatal (default: info in production, debug in development)
LOG_LEVEL=debug

DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# LiveKit (required for live meetings) - https://livekit.io
LIVEKIT_URL=wss://your-livekit.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: S3 bucket for egress recordings (e.g. room-composite MP4 files)
LIVEKIT_EGRESS_S3_BUCKET=

CLIENT_URL=http://localhost:5173
