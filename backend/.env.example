NODE_ENV=development
PORT=5000
# trace | debug | info | warn | error | fatal (default: info in production, debug in development)
LOG_LEVEL=debug

DATABASE_URL=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

CLIENT_URL=http://localhost:5173
