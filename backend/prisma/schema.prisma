generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum MeetingRole {
  HOST
  COHOST
  STUDENT
  GUEST
}

model User {
  id                  String                 @id @default(cuid())
  name                String
  email               String                 @unique
  password            String?
  role                Role                   @default(STUDENT)
  profileImage        String?
  isVerified          Boolean                @default(false)
  oauthAccounts       OAuthAccount[]
  courses             Course[]               @relation("CourseCreator")
  progress            Progress[]
  communityMessages   CommunityMessage[]     @relation("CommunityMessages")
  videoComments       VideoComment[]         @relation("VideoComments")
  hostedMeetings      Meeting[]              @relation("HostedMeetings")
  meetingParticipants MeetingParticipant[]
  meetingChatMessages MeetingChatMessage[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
}

model Meeting {
  id              String               @id @default(cuid())
  title           String
  description     String?
  thumbnail       String?
  hostId          String
  host            User                 @relation("HostedMeetings", fields: [hostId], references: [id], onDelete: Cascade)
  roomName        String               @unique
  joinCode        String               @unique
  status          MeetingStatus        @default(SCHEDULED)
  scheduledAt     DateTime
  startedAt       DateTime?
  endedAt         DateTime?
  maxParticipants Int                  @default(50)
  recordingUrl    String?
  participants    MeetingParticipant[]
  chatMessages    MeetingChatMessage[]
  attendance      MeetingAttendance[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([hostId])
  @@index([status])
  @@index([scheduledAt])
}

model MeetingParticipant {
  id          String                 @id @default(cuid())
  meetingId   String
  meeting     Meeting                @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  name        String
  role        MeetingRole            @default(STUDENT)
  joinedAt    DateTime               @default(now())
  leftAt      DateTime?
  attendance  MeetingAttendance?
  createdAt   DateTime               @default(now())

  @@unique([meetingId, userId])
  @@index([meetingId])
}

model MeetingChatMessage {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  message   String
  createdAt DateTime @default(now())

  @@index([meetingId])
  @@index([createdAt])
}

model MeetingAttendance {
  id            String              @id @default(cuid())
  meetingId     String
  meeting       Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  participantId String              @unique
  participant   MeetingParticipant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  duration      Int                 @default(0)
  cameraOnTime  Int                 @default(0)
  micOnTime     Int                 @default(0)
  updatedAt     DateTime            @updatedAt

  @@unique([meetingId, participantId])
  @@index([meetingId])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Course {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String
  thumbnail   String?
  createdBy   String
  creator     User      @relation("CourseCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  sections    Section[]
  videos      Video[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdBy])
}

model Section {
  id       String  @id @default(cuid())
  courseId String
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  order    Int
  videos   Video[]

  @@index([courseId])
}

model Video {
  id            String         @id @default(cuid())
  courseId      String
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionId     String?
  section       Section?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  duration      Int?
  thumbnail     String?
  s3Key         String         @unique
  videoUrl      String?
  order         Int            @default(0)
  allowDownload Boolean        @default(false)
  resources     Resource[]
  progress      Progress[]
  comments      VideoComment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([courseId])
  @@index([sectionId])
}

model Resource {
  id      String @id @default(cuid())
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  title   String
  fileUrl String
  type    String @default("pdf")

  @@index([videoId])
}

model Progress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId       String
  video         Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  lastTimestamp Int      @default(0)
  completed     Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([userId])
}

model CommunityMessage {
  id        String             @id @default(cuid())
  content   String
  authorId  String
  author    User               @relation("CommunityMessages", fields: [authorId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    CommunityMessage?  @relation("CommunityReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CommunityMessage[] @relation("CommunityReplies")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([authorId])
  @@index([parentId])
  @@index([createdAt])
}

model VideoComment {
  id        String   @id @default(cuid())
  content   String
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("VideoComments", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([videoId])
  @@index([authorId])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
