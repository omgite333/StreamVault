# Base URL for the backend API. Leave empty in development to use the Vite proxy (/api -> localhost:5000).
# In production set the full backend URL, e.g. https://api.streamvault.app/api
VITE_API_URL=

# LiveKit server URL for live meetings (e.g. wss://your-livekit.livekit.cloud)
VITE_LIVEKIT_URL=wss://streamvault-876l6y9v.livekit.cloud